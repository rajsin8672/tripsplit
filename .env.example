# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Project & Admin SDK (Server-Side)
# Obtain these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=tripsplit-944f7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tripsplit-944f7.iam.gserviceaccount.com
# Private key should include newline characters or raw multiline PEM with \n escaped or actual newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Firebase Web Client Configuration (Served to browser via /api/config/firebase)
# Obtain these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=tripsplit-944f7.firebaseapp.com
FIREBASE_STORAGE_BUCKET=tripsplit-944f7.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-id
FIREBASE_MEASUREMENT_ID=G-CPFRSKNRN3

# Administrator Access (Comma-separated emails with administrator rights)
ADMIN_EMAILS=admin@example.com
